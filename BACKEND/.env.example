# Django
DJANGO_SECRET_KEY=change_me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2,0.0.0.0
DJANGO_SETTINGS_MODULE=app.settings.local

# Base de datos (PostGIS) — usar host `postgres` con docker compose
DATABASE_URL=postgis://postgres:postgres@localhost:5432/wanti_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=wanti_db

# Redis / Celery — usar host `redis` con docker compose
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
# JWT_SIGNING_KEY=  # producción: distinto de DJANGO_SECRET_KEY

# Twilio (OTP WhatsApp/SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=+15005550006
TWILIO_ENABLED=false

# Email
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@wanti.co
FRONTEND_BASE_URL=http://localhost:3000

# Pasarela de pagos
PAYMENT_PROVIDER=sandbox
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# IA de imágenes
AI_IMAGE_PROVIDER=mock
AI_IMAGE_API_KEY=

# Almacenamiento de archivos
STORAGE_BACKEND=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# Logging
LOG_LEVEL=INFO
LOG_JSON=false

# GeoDjango (macOS Homebrew — ajustar paths según el sistema)
# GDAL_LIBRARY_PATH=/usr/local/opt/gdal/lib/libgdal.dylib
# GEOS_LIBRARY_PATH=/usr/local/opt/geos/lib/libgeos_c.dylib
