# OS / IDE
.DS_Store
.cursor/
.idea/
.vscode/
*.swp

# Secrets (never commit)
.env
.env.*
!.env.example
!.env.production.example
**/.env
**/.env.*
!**/.env.example
!**/.env.production.example

# Python
**/__pycache__/
**/*.py[cod]
**/venv/
**/.venv/
**/env/

# Flutter / Dart build caches (FRONTEND/.gitignore also covers these)
FRONTEND/build/
FRONTEND/.dart_tool/
FRONTEND/.flutter-plugins-dependencies

# Backups / dumps
*.dump
*.dump.gz
backups/

# Deploy keys
wanti.pem
*.pem
!BACKEND/docker/certs/.gitkeep

# Local catalog dumps (imported via CSV in apps/catalog)
catalogo_vehiculos_colombia_masivo.*
